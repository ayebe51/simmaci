              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"border: 1px solid #e2e8f0; border-radius: 24px; padding: 28px; background: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03); display: flex; gap: 20px; align-items: center; flex-wrap: wrap;\"><img src=\"https://simmaci.com/images/foto-sekretaris.png\" alt=\"Sekretaris PC LP Maarif NU Cilacap\" style=\"width: 110px; height: 130px; object-fit: cover; border-radius: 16px; border: 2px solid #047857; flex-shrink: 0;\" onerror=\"this.src='https://maarifnucilacap.or.id/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-25-at-15.03.53-scaled.jpeg'\"/><div style=\"flex: 1; min-width: 180px;\"><span style=\"display: inline-block; background: #ecfdf5; color: #047857; font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 6px; text-transform: uppercase; margin-bottom: 6px;\">Sekretaris PC LP Ma'arif NU</span><h3 style=\"font-size: 18px; font-weight: 900; color: #0f172a; margin: 0 0 6px 0; font-family: 'Plus Jakarta Sans', sans-serif;\">Baharudin Yusuf, M.Pd.</h3><p style=\"color: #64748b; font-size: 13px; line-height: 1.5; margin: 0;\">\"Tertib administrasi, akuntabilitas kelembagaan, dan pelayanan digital untuk segenap madrasah di Cilacap.\"</p></div></div>"
