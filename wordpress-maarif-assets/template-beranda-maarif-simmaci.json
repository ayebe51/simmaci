            "_column_size": 100
          },
          "elements": [
            {
              "id": "news_heading",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div id=\"warta\" style=\"display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; flex-wrap: wrap; gap: 14px;\"><div><span style=\"display: inline-block; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 4px 14px; border-radius: 9999px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;\">Warta & Literasi</span><h2 style=\"font-size: 28px; font-weight: 900; color: #0f172a; margin: 0 0 6px 0; font-family: 'Plus Jakarta Sans', sans-serif;\">Kabar, Khazanah & Edukasi Terkini</h2><p style=\"color: #64748b; font-size: 14px; margin: 0;\">Publikasi resmi kegiatan madrasah, esai pemikiran keaswajaan, dan wawasan regulasi.</p></div><div style=\"display: flex; gap: 8px; flex-wrap: wrap;\"><a href=\"/berita\" style=\"background: #047857; color: #ffffff; font-size: 11px; font-weight: 800; padding: 8px 16px; border-radius: 10px; text-decoration: none; text-transform: uppercase;\">Berita</a><a href=\"/khazanah\" style=\"background: #ffffff; color: #047857; border: 1px solid #e2e8f0; font-size: 11px; font-weight: 800; padding: 8px 16px; border-radius: 10px; text-decoration: none; text-transform: uppercase;\">Khazanah</a><a href=\"/maarif-pedia\" style=\"background: #ffffff; color: #047857; border: 1px solid #e2e8f0; font-size: 11px; font-weight: 800; padding: 8px 16px; border-radius: 10px; text-decoration: none; text-transform: uppercase;\">Ma'arif Pedia</a></div></div>"
              }
            },
            {
              "id": "news_feed_widget",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div id=\"simmaci-warta-feed\"><div style=\"text-align: center; padding: 40px; color: #94a3b8; font-weight: 600;\">Memuat warta terbaru...</div></div><script>(function(){fetch('https://maarifnucilacap.or.id/wp-json/wp/v2/posts?per_page=6&_embed=1').then(r=>r.json()).then(posts=>{if(!posts||posts.length===0){document.getElementById('simmaci-warta-feed').innerHTML='<p style=\"text-align:center;\">Belum ada artikel.</p>';return;}var html='<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;\">';posts.forEach(function(p){var img=p._embedded&&p._embedded['wp:featuredmedia']&&p._embedded['wp:featuredmedia'][0]?p._embedded['wp:featuredmedia'][0].source_url:'https://maarifnucilacap.or.id/wp-content/uploads/2026/09/WhatsApp-Image-2026-09-25-at-15.03.53-scaled.jpeg';var title=p.title.rendered;var link=p.link;var author=p._embedded&&p._embedded.author&&p._embedded.author[0]?p._embedded.author[0].name:'Redaksi';var date=new Date(p.date).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'});html+='<article style=\"background:#ffffff; border:1px solid #e2e8f0; border-radius:20px; overflow:hidden; box-shadow:0 4px 6px -1px rgba(0,0,0,0.03); display:flex; flex-direction:column; justify-content:between;\"><div style=\"aspect-ratio:16/9; overflow:hidden;\"><img src=\"'+img+'\" alt=\"'+title+'\" style=\"width:100%; height:100%; object-fit:cover; transition:transform .3s;\" onmouseover=\"this.style.transform=\\'scale(1.04)\\'\" onmouseout=\"this.style.transform=\\'scale(1)\\'\" loading=\"lazy\"/></div><div style=\"padding:20px;\"><div style=\"font-size:11px; font-weight:600; color:#10b981; margin-bottom:6px;\">📅 '+date+' • '+author+'</div><h3 style=\"font-size:16px; font-weight:800; color:#0f172a; margin:0 0 10px 0; line-height:1.4;\"><a href=\"'+link+'\" style=\"color:#0f172a; text-decoration:none;\">'+title+'</a></h3><a href=\"'+link+'\" style=\"display:inline-block; font-size:12px; font-weight:800; color:#047857; text-decoration:none;\">Baca Selengkapnya →</a></div></article>';});html+='</div>';document.getElementById('simmaci-warta-feed').innerHTML=html;}).catch(function(e){document.getElementById('simmaci-warta-feed').innerHTML='<p style=\"text-align:center; color:#ef4444;\">Gagal memuat warta terkini.</p>';});})();</script>"
