        {
          "id": "stats_col",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "stats_heading",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"text-align: center; max-width: 680px; margin: 0 auto 30px auto;\"><span style=\"display: inline-block; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 4px 14px; border-radius: 9999px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;\">Live Data • SIMMACI</span><h2 style=\"font-size: 28px; font-weight: 900; color: #0f172a; margin: 0 0 8px 0; font-family: 'Plus Jakarta Sans', sans-serif;\">Statistik Pendidikan Ma'arif Cilacap</h2><p style=\"color: #64748b; font-size: 14px; margin: 0;\">Data terintegrasi secara otomatis dari Sistem Informasi Manajemen SIMMACI</p></div>"
              }
            },
            {
              "id": "stats_shortcode_widget",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div id=\"simmaci-stats-elementor-box\"><div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; max-width: 1100px; margin: 0 auto;\"><div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 26px 18px; text-align: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);\"><div style=\"font-size: 32px; margin-bottom: 8px;\">🏫</div><div id=\"el-stat-schools\" style=\"font-size: 34px; font-weight: 900; color: #047857; line-height: 1.1; margin-bottom: 4px;\">207+</div><div style=\"font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 3px;\">Madrasah & Sekolah</div><div style=\"font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;\">MI • MTs • MA • SMK</div></div><div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 26px 18px; text-align: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);\"><div style=\"font-size: 32px; margin-bottom: 8px;\">👨‍🏫</div><div id=\"el-stat-teachers\" style=\"font-size: 34px; font-weight: 900; color: #047857; line-height: 1.1; margin-bottom: 4px;\">1.719+</div><div style=\"font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 3px;\">Tenaga Pendidik (Guru)</div><div style=\"font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;\">Aktif Terdata</div></div><div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 26px 18px; text-align: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);\"><div style=\"font-size: 32px; margin-bottom: 8px;\">👔</div><div id=\"el-stat-tendiks\" style=\"font-size: 34px; font-weight: 900; color: #047857; line-height: 1.1; margin-bottom: 4px;\">225+</div><div style=\"font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 3px;\">Tenaga Kependidikan</div><div style=\"font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;\">Staf & Administrasi</div></div><div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 26px 18px; text-align: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);\"><div style=\"font-size: 32px; margin-bottom: 8px;\">🎒</div><div id=\"el-stat-students\" style=\"font-size: 34px; font-weight: 900; color: #047857; line-height: 1.1; margin-bottom: 4px;\">39.424+</div><div style=\"font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 3px;\">Peserta Didik</div><div style=\"font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em;\">Siswa Terdaftar</div></div></div><p style=\"text-align: center; font-size: 12px; color: #64748b; font-weight: 600; margin-top: 20px;\">Tersebar di 24 Wilayah Kecamatan se-Kabupaten Cilacap</p></div><script>(function(){function fmt(n){return new Intl.NumberFormat('id-ID').format(n);}fetch('https://simmaci.com/api/public/portal/stats').then(r=>r.json()).then(res=>{if(res&&res.data){var d=res.data;if(d.total_schools)document.getElementById('el-stat-schools').innerText=fmt(d.total_schools);if(d.total_teachers)document.getElementById('el-stat-teachers').innerText=fmt(d.total_teachers);if(d.total_tendiks)document.getElementById('el-stat-tendiks').innerText=fmt(d.total_tendiks);if(d.total_students)document.getElementById('el-stat-students').innerText=fmt(d.total_students);}}).catch(function(e){console.warn('Fallback static stats:',e);});})();</script>"
              }
